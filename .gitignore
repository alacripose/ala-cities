# Build output
/target
**/*.pdb

# Local playthrough state.
#
# The world snapshot is local and disposable: it is one city at one moment, and
# it is large. The season record beside it — tickets, evidence, retirements,
# corrections — is the city's own history, and history is tracked. That is the
# whole point of keeping it in a portable object layout rather than in a binary
# blob.
/saves/*.ron
/saves/*.tmp

# Crash dumps and logs
*.dmp
*.log

# Python bytecode. The icon pipeline is run, not compiled, and a .pyc in a public
# repository is a build artifact from one machine at one moment.
__pycache__/
*.pyc

# Reference corpora, recorded by digest rather than vendored (C7 a136): the
# MD1 pack is Apache-2.0 but is not redistributed here, and the TouchWiz and
# iOS 6 packs are reference-grade only (see docs/GRILLING-C3.md, round 17).
# The manifest's digests carry the provenance; the packs stay local.
/assets/reference/

# Superseded icon renders kept as local historical evidence, never active assets.
/assets/icons/archive/

# Blender backup/autosave files; the shared reference.blend is intentional.
/assets/icons/*.blend1
/assets/icons/*.blend@

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
