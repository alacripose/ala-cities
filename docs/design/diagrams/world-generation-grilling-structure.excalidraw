    {"type":"text","id":"retired-strip-text","x":85,"y":844,"width":1400,"height":82,"text":"RETIRED / DEMOTED\nflat World·Tile truth · cosmetic edge road · 8 m as voxel scale · cache as save\nv3 target lineage · direct editor mutation · player-completion prerequisite · optional/detached asset path\nhard-label biomes · water-only cases · no dynamics switched on at implementation landing","originalText":"RETIRED / DEMOTED\nflat World·Tile truth · cosmetic edge road · 8 m as voxel scale · cache as save\nv3 target lineage · direct editor mutation · player-completion prerequisite · optional/detached asset path\nhard-label biomes · water-only cases · no dynamics switched on at implementation landing","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f8fafc","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":31057,"version":1,"versionNonce":41057,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
